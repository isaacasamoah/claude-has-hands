{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "extension/src/**/*.ts",
    "native-host/src/**/*.ts",
    "scripts/**/*.ts",
    "test/scenarios/**/*.ts"
  ]
}
