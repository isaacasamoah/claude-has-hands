{
  "name": "claude-has-hands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacasamoah/claude-has-hands.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Guarded local bridge that lets AI coding CLIs drive your real, signed-in Chrome over MCP, REST and a shell CLI",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "build:extension": "node esbuild.config.mjs --extension",
    "build:native-host": "node esbuild.config.mjs --native-host",
    "install:host": "./scripts/install.sh",
    "dev": "./scripts/dev.sh",
    "test": "npm run typecheck && node --test test/unit/*.test.ts",
    "docs:tools": "node scripts/generate-tools-doc.ts > docs/tools.md",
    "clean": "rm -rf extension/dist native-host/dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "license": "MIT"
}
